    "@vue/devtools-api": "^8.2.1",
    "file-saver": "^2.0.5",
    "js-cookie": "^3.0.7",
    "jszip": "^3.10.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.0.3",
    "typescript": "~5.9.0",
